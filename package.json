{
  "name": "JobPilot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --filter @jobpilot/web dev",
    "dev:server": "pnpm --filter @jobpilot/server dev",
    "dev:all": "pnpm --parallel --filter @jobpilot/server --filter @jobpilot/web dev",
    "build": "pnpm db:generate && pnpm --filter @jobpilot/database build && pnpm --filter @jobpilot/server build && pnpm --filter @jobpilot/web build",
    "build:database": "pnpm db:generate && pnpm --filter @jobpilot/database build",
    "build:server": "pnpm db:generate && pnpm --filter @jobpilot/database build && pnpm --filter @jobpilot/server build",
    "build:web": "pnpm --filter @jobpilot/web build",
    "start": "pnpm --filter @jobpilot/server start",
    "start:server": "pnpm --filter @jobpilot/server start",
    "start:web": "pnpm --filter @jobpilot/web start",
    "start:all": "pnpm --parallel --filter @jobpilot/server --filter @jobpilot/web start",
    "test": "pnpm --filter @jobpilot/server test",
    "db:push": "pnpm --filter @jobpilot/database exec prisma db push",
    "db:generate": "pnpm --filter @jobpilot/database exec prisma generate",
    "db:migrate:deploy": "pnpm --filter @jobpilot/database migrate:deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.1.2",
  "type": "module",
  "dependencies": {
    "playwright": "^1.62.1"
  }
}
