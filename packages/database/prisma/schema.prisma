generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum JobStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

enum ResumeStatus {
  PROCESSING
  READY
  FAILED
}

model User {
  id String @id @default(cuid())

  email    String @unique
  password String

  role     UserRole  @default(USER)
  profile  Profile?

  resumes      Resume[]
  jobs         Job[]
  companies    Company[]
  applications Application[]
  agentRuns    AgentRun[]
  notifications Notification[]
  auditLogs    AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id String @id @default(cuid())

  name     String
  website  String?
  linkedin String?
  location String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobs Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Resume {
  id String @id @default(cuid())

  title         String
  originalName  String
  fileUrl       String
  extractedText String?
  applications  Application[]

  status ResumeStatus @default(PROCESSING)

  profileId String?

  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Job {
  id String @id @default(cuid())

  title    String
  location String
  url      String

  status       JobStatus     @default(SAVED)
  applications Application[]
  auditLogs    AuditLog[]

  notes String?

  appliedAt   DateTime?
  coverLetter String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([companyId])
}

model Application {
  id String @id @default(cuid())

  status ApplicationStatus @default(PENDING)

  attempts Int @default(0)

  appliedAt DateTime?

  failureReason String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  profileId String?

  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  notifications Notification[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([resumeId])
  @@index([status])
}

enum ApplicationStatus {
  PENDING
  MATCHED
  QUEUED
  RUNNING
  SUBMITTED
  FAILED
  SKIPPED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

model Profile {
  id String @id @default(cuid())

  firstName  String
  middleName String?
  lastName   String

  email String?
  phone String?

  dateOfBirth DateTime?

  gender      String?
  nationality String?

  address String?
  city    String?
  state   String?
  country String?
  zipCode String?

  currentTitle   String?
  currentCompany String?

  resumes Resume[]

  applications Application[]

  yearsOfExperience Float?

  expectedSalary Int?
  currentSalary  Int?

  noticePeriod Int?

  github    String?
  linkedin  String?
  portfolio String?
  website   String?

  leetcode   String?
  codeforces String?

  workMode       WorkMode       @default(HYBRID)
  employmentType EmploymentType @default(FULL_TIME)

  willingToRelocate Boolean @default(false)
  willingToTravel   Boolean @default(false)

  remoteOnly Boolean @default(false)

  sponsorshipRequired Boolean @default(false)

  visaStatus String?

  governmentEmployee Boolean @default(false)

  militaryService Boolean @default(false)

  veteran Boolean @default(false)

  criminalRecord Boolean @default(false)

  securityClearance Boolean @default(false)

  disability Boolean @default(false)

  summary String?

  isDefault Boolean @default(false)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  educations ProfileEducation[]

  experiences ProfileExperience[]

  skills ProfileSkill[]

  languages ProfileLanguage[]

  certifications ProfileCertification[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  profileProjects ProfileProject[]
  profileLinks    ProfileLink[]

  @@index([userId])
}

model ProfileSkill {
  id String @id @default(cuid())

  name String

  category String?

  level String?

  yearsOfExperience Float?

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([name])
}

model ProfileEducation {
  id String @id @default(cuid())

  degree String

  institution String

  fieldOfStudy String?

  grade String?

  startDate DateTime?

  endDate DateTime?

  currentlyStudying Boolean @default(false)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

model ProfileExperience {
  id String @id @default(cuid())

  company String

  title String

  location String?

  description String?

  employmentType EmploymentType?

  startDate DateTime?

  endDate DateTime?

  currentlyWorking Boolean @default(false)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

model ProfileLanguage {
  id String @id @default(cuid())

  name String

  proficiency String?

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

model ProfileCertification {
  id String @id @default(cuid())

  name String

  issuer String?

  credentialId String?

  credentialUrl String?

  issuedAt DateTime?

  expiresAt DateTime?

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

model ProfileProject {
  id String @id @default(cuid())

  title String

  description String?

  githubUrl String?

  liveUrl String?

  technologies String?

  startDate DateTime?

  endDate DateTime?

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

model ProfileLink {
  id String @id @default(cuid())

  label String

  url String

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model AgentRun {
  id String @id @default(cuid())

  threadId String @unique
  query    String

  status AgentRunStatus @default(RUNNING)

  history String[] @default([])
  errors  String[] @default([])

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  notifications Notification[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_FAILED
  APPLICATION_STATUS
  AGENT_COMPLETED
  AGENT_FAILED
  SYSTEM
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String

  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  agentRunId String?
  agentRun   AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, readAt])
  @@index([applicationId])
  @@index([agentRunId])
  @@index([createdAt])
}

enum AuditAction {
  AGENT_STARTED
  AGENT_COMPLETED
  AGENT_FAILED
  JOB_DISCOVERED
  JOB_SELECTED
  APPLICATION_CREATED
  APPLICATION_STARTED
  APPLICATION_SUBMITTED
  APPLICATION_FAILED
  APPLICATION_RETRIED
  USER_ACTION_REQUIRED
  USER_ACTION_COMPLETED
  SYSTEM
}

model AuditLog {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  action      AuditAction
  description String

  agentRunId String?
  agentRun   AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  jobId String?
  job   Job? @relation(fields: [jobId], references: [id], onDelete: Cascade)

  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([agentRunId])
  @@index([applicationId])
  @@index([jobId])
  @@index([createdAt])
}