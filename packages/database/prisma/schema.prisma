generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum JobStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

enum ResumeStatus {
  PROCESSING
  READY
  FAILED
}

model User {
  id String @id @default(cuid())

  email    String @unique
  password String

  role UserRole @default(USER)

  resumes   Resume[]
  jobs      Job[]
  companies Company[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id String @id @default(cuid())

  name     String
  website  String?
  linkedin String?
  location String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobs Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Resume {
  id String @id @default(cuid())

  title         String
  originalName  String
  fileUrl       String
  extractedText String?

  status ResumeStatus @default(PROCESSING)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Job {
  id String @id @default(cuid())

  title    String
  location String
  url      String

  status JobStatus @default(SAVED)

  notes String?

  appliedAt   DateTime?
  coverLetter String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([companyId])
}
